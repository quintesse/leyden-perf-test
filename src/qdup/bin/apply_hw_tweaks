#!/bin/bash
set -uo pipefail

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

echo "Applying hardware tweaks on ${HOSTNAME}..."
source "${script_dir}/../../../hardware-tweaks.conf"
source "${script_dir}/../../scripts/hwtweakfuncs.sh"
if check_hwtweak_requirements && detect_cpu_info; then
    apply_hardware_tweaks
else
    echo "Warning: Hardware tweaks requirements not met, skipping..."
fi
