#!/bin/bash
set -uo pipefail

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

if [ "$#" -lt 3 ]; then
    echo "Usage: $0 <hosts_file> <strategy> <java_version> [test_pattern] [profiles] [work_dir] [result_dir] [qdup_temp] [options]..."
    exit 1
fi

if [[ "$1" == /* || "$1" == .* ]]; then
    # Path to a hosts yml file
    hosts_file="$1"
else
    # Name of a hosts file in the ../hosts directory
    hosts_file="${script_dir}/../hosts/$1.yml"
fi

scripts_file="${script_dir}/../scripts.yml"

strategy="$2"
strategy_file="${script_dir}/../test-${strategy}.yml"

java_version="$3"

qdup_temp="${4:-/tmp/qdup}"

# Shift past the first 4 positional arguments to get additional states
shift 4

# Build the qdup command with caller-provided states
"$script_dir/qdup" "${scripts_file}" "${hosts_file}" "${strategy_file}" -B "${qdup_temp}" "$@"
