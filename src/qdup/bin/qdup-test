#!/bin/bash
set -uo pipefail

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

if [[ "$1" == /* || "$1" == .* ]]; then
    # Path to a hosts yml file
    hosts_file="$1"
else
    # Name of a hosts file in the ../hosts directory
    hosts_file="${script_dir}/../hosts/$1.yml"
fi

scripts_file="${script_dir}/../scripts.yml"

strategy="$2"
strategy_file="${script_dir}/../test-${strategy}.yml"

java_version="$3"

testpat="${4:-all}"
profiles="${5:-}"
work_dir="${6:-/tmp/leyden-perf-test}"

# Shift past the first 6 positional arguments to get additional states
shift 6

# Build the qdup command with caller-provided states
"$script_dir/qdup" "${scripts_file}" "${hosts_file}" "${strategy_file}" -B "${work_dir}/qdup" "$@"
