#!/bin/bash
set -uo pipefail

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

if [[ "$1" == /* || "$1" == .* ]]; then
    # Path to a hosts yml file
    hosts_file="$1"
else
    # Name of a hosts file in the ../hosts directory
    hosts_file="${script_dir}/../hosts/$1.yml"
fi

scripts_file="${script_dir}/../scripts.yml"

strategy="$2"
strategy_file="${script_dir}/../test-${strategy}.yml"

testpat="${3:-all}"
results_dir="${4:-/tmp/leyden-perf-test/results}"
cache_dir="${5:-/tmp/leyden-perf-test/cache}"

# Temporary directory for qDup working files
temp_dir="/tmp/leyden-perf-test"

"$script_dir/qdup" "${scripts_file}" "${hosts_file}" "${strategy_file}" \
    -B "${temp_dir}/qdup" \
    -S TEST="${testpat}" \
    -S RESULTS_DIR="${results_dir}" \
    -S CACHE_DIR="${cache_dir}" \
    -S TEMP_DIR="${temp_dir}"
