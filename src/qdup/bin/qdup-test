#!/bin/bash
set -uo pipefail

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

if [[ "$1" == /* || "$1" == .* ]]; then
    # Path to a hosts yml file
    hosts_file="$1"
else
    # Name of a hosts file in the ../hosts directory
    hosts_file="${script_dir}/../hosts/$1.yml"
fi

scripts_file="${script_dir}/../scripts.yml"

strategy="$2"
strategy_file="${script_dir}/../test-${strategy}.yml"

java_version="$3"

testpat="${4:-all}"
work_dir=${5:-/tmp/leyden-perf-test}
profiles="${6:-}"

# Build the qdup command with profiles as a state variable
"$script_dir/qdup" "${scripts_file}" "${hosts_file}" "${strategy_file}" -B ${work_dir}/qdup -S JAVA_VERSION="${java_version}" -S TEST="${testpat}" -S WORK_DIR="${work_dir}" -S PROFILES="${profiles}"
